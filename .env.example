# Settings for running the app yourself (`npm run dev`, or a host other than the two below).
# - Vercel: the Deploy button asks only for the values marked [Vercel]; see docs/deploy-vercel.md.
# - Docker: ./setup.sh writes its own .env; see docs/deploy-docker.md.

# [Vercel] Supabase Postgres. On Vercel use the pooler (transaction mode) connection string.
# Vercel's Supabase integration sets POSTGRES_URL instead, which is used when this is blank.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@<region>.pooler.supabase.com:6543/postgres

# Recommended: the CA certificate of the database provider, so the server is verified
# as well as the connection encrypted. Supabase: Project Settings > Database > SSL
# Configuration > Download certificate; paste the whole PEM text here.
DATABASE_CA_CERT=
# Without it the connection is still encrypted, but the server is not verified, so anyone on
# the network path could pose as the database; the app logs a warning at startup. Set this
# only to silence that warning for a database on a private network you trust.
# DATABASE_TLS_UNVERIFIED=true

# [Vercel] Bot token from @BotFather. Server only; it validates Mini App initData.
TELEGRAM_BOT_TOKEN=

# [Vercel] 32+ random characters, e.g. `openssl rand -hex 24`. Keys the stored hashes of
# session tokens and enrollment codes. Changing it signs everyone out. It is also the
# setup key for the first-time setup page at /setup.
APP_SECRET=

# Which edge sets the client IP header that the server trusts: vercel | cloudflare | none.
# Use "vercel" only on Vercel (anywhere else clients can forge x-real-ip), and "cloudflare"
# only if the origin accepts traffic from Cloudflare alone. On Vercel, leaving it blank picks
# vercel; anywhere else blank means none. Docker sets this itself (see docker-compose.yml).
TRUSTED_PROXY=

# Only with TRUSTED_PROXY=cloudflare: 16+ random characters that a Cloudflare Transform
# Rule adds to every request as the `x-origin-secret` header. Without it client IPs are
# ignored, because anyone reaching the origin directly could forge cf-connecting-ip.
CLOUDFLARE_ORIGIN_SECRET=

# Optional. Bot username without @, for portal sign-in from a desktop browser (Telegram
# Login Widget). When blank the app asks Telegram for it. Also run /setdomain in @BotFather
# with the app's domain.
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=

# [Vercel] 16+ random characters. Protects /api/internal/attendance-check (daily, Vercel Cron sends
# it automatically) and /api/internal/reminders (every 5 minutes from an external
# scheduler such as cron-job.org, with the header `Authorization: Bearer <CRON_SECRET>`).
CRON_SECRET=

# [Vercel] 16+ characters (letters, digits, _ and -). Telegram sends it back with every
# webhook call. The /setup page registers the bot with it; later changes need
# `npm run bot:setup`.
TELEGRAM_WEBHOOK_SECRET=

# Public URL of the app; used for branch QR content and the bot's "open app" button.
# On Vercel it defaults to the project's production domain.
APP_URL=https://your-domain.example

# Optional tuning (defaults shown)
# TELEGRAM_INIT_DATA_MAX_AGE_SECONDS=3600
# SESSION_TTL_HOURS=24
# PIN_SESSION_TTL_MINUTES=720

# Local development only, with TRUSTED_PROXY=none: the IP requests are treated as coming from.
# DEV_CLIENT_IP=203.0.113.20
